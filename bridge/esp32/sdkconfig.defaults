# Settings shared by every chip. Chip-specific settings live in
# sdkconfig.defaults.<chip>, which ESP-IDF applies on top of this file.

# Flash and partitions (bridge spec 4.1 and 14.1): 4 MB is the smallest
# flash on any supported board.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# A new firmware image must confirm itself after a healthy start, or the
# bootloader returns to the previous one (bridge spec 14.2).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Optimise for size: the image must stay under 1.5 MB (bridge spec 14.1).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The Link WebSocket (bridge spec 8.2) needs the HTTP server's WebSocket
# support and its handshake hooks (before: so a full bridge can answer 503;
# after: where a session begins).
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# Sockets in use at most: the Link server's 8 sessions and 3 extra
# (HTTP_LINK_EXTRA_SOCKETS) plus its listening socket and two control
# sockets, 14; port 80's 7 (HTTP_SETUP_MAX_SOCKETS) plus its three, 10; the
# captive DNS, 1. That is 25; 28 leaves a little room, since a server that
# cannot get its sockets fails to start, and the boot with it. mDNS and SNTP
# use lwIP directly, not sockets.
CONFIG_LWIP_MAX_SOCKETS=28

# Each HTTP server's control queue, which carries the send pump and every
# socket close, holds this many waiting jobs. The default 6 overflowed when
# several clients left at once.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16

# ESP-IDF's event task runs the Wi-Fi state changes (components/net), which
# include saving the network to flash and starting SNTP; the default 2304
# bytes is too tight for that.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# A 1 ms scheduler tick, so the UART link's 2 ms idle gap and 5 ms listen
# slice are real (bridge spec 7.2). The default 10 ms tick would round them
# away.
CONFIG_FREERTOS_HZ=1000
